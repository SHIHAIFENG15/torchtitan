[rank0]:{"name": "cloud_assist", "description": "Ask a stronger reviewer/advisor model for guidance. Takes NO parameters: call cloud_assist() with an empty object, and your full conversation history is automatically forwarded. Call it near the start of complex tasks (after orientation, before substantive work), when stuck or changing approach, mid-task whenever you've gathered new evidence that might shift your plan, and before declaring done after saving durable deliverables.", "parameters": {"type": "object", "properties": {}, "additionalProperties": false}}
